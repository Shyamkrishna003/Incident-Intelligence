# Local development configuration. Create your own copy with `make env` (never commit .env).
# Values here are placeholders for a local, throwaway database only.

ENVIRONMENT=local
LOG_LEVEL=INFO
# true = JSON lines; false = human-readable console output
LOG_JSON=true

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=incident_intel
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=incident_intel
# Host port for the compose database. 5433 avoids clashing with a host PostgreSQL on 5432.
POSTGRES_PORT=5433

# Used by the host tooling (alembic, ii CLI, pytest). The api container builds its own URL.
DATABASE_URL=postgresql+asyncpg://incident_intel:local-dev-only-change-me@localhost:5433/incident_intel
# Integration tests; the database name must end in _test (created automatically by compose).
TEST_DATABASE_URL=postgresql+asyncpg://incident_intel:local-dev-only-change-me@localhost:5433/incident_intel_test

# --- Kafka (docker compose) ---
# Host tooling uses the EXTERNAL listener; containers use kafka:9092 (set in compose).
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# End-to-end tests create and delete their own uniquely named topics on this broker.
TEST_KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# --- Redis (docker compose) ---
# Cache and rate limiter only. Used by the API and by `ii api-keys revoke`.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Tests use database 15 and a random key prefix, and delete only their own keys.
TEST_REDIS_URL=redis://localhost:6379/15
# Per API key: requests allowed per window. Over the limit -> 429 with Retry-After.
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60

# --- Firebase Authentication (sign-in for human users) ---
# The Firebase project ID: a public identifier, not a secret. It is all the backend needs
# to verify ID tokens. Leave empty to disable user sign-in (user endpoints answer 503).
FIREBASE_PROJECT_ID=
# Local development only: verify against the emulator (`make emulator`), which issues
# unsigned tokens. Use project id demo-incident-intel with it. Refused in production.
FIREBASE_AUTH_EMULATOR_HOST=
# Enables the emulator tests. Requires `make emulator`.
TEST_FIREBASE_AUTH_EMULATOR_HOST=

# --- Web app (frontend) ---
# The Firebase web config from the Firebase console (Project settings > Your apps). These
# are public identifiers, not secrets: they end up in the browser bundle by design.
# Only variables starting with VITE_ are ever exposed to the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local development only: sign in against the emulator (`make emulator`) instead of real
# Firebase. Also set VITE_FIREBASE_PROJECT_ID=demo-incident-intel and the two backend
# emulator settings above.
VITE_FIREBASE_AUTH_EMULATOR_URL=

# --- AI investigation (Gemini) ---
# SECRET. Create one at https://aistudio.google.com (Get API key). Only the investigation
# worker receives it. Leave empty to disable AI investigations.
GEMINI_API_KEY=
# Which Gemini model writes the reports.
GEMINI_MODEL=gemini-3.5-flash

# --- Stored integration secrets (GitHub) ---
# SECRET. Encrypts each project's GitHub token in the database. Used by the API (to store a
# token) and the investigation worker (to read it). `make env` generates one; for an existing
# .env run `make secrets-key`. Leave empty to disable the GitHub integration.
# Changing it makes every stored token unreadable: projects must connect GitHub again.
SECRETS_ENCRYPTION_KEY=

# --- API keys ---
# Server-side pepper for API-key hashes (min 32 chars). `make env` generates one.
# Changing it invalidates every existing API key.
API_KEY_PEPPER=
