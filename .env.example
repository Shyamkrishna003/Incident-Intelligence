# Local development configuration. Create your own copy with `make env` (never commit .env).
# Values here are placeholders for a local, throwaway database only.

ENVIRONMENT=local
LOG_LEVEL=INFO
# true = JSON lines; false = human-readable console output
LOG_JSON=true

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=incident_intel
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=incident_intel
# Host port for the compose database. 5433 avoids clashing with a host PostgreSQL on 5432.
POSTGRES_PORT=5433

# Used by the host tooling (alembic, ii CLI, pytest). The api container builds its own URL.
DATABASE_URL=postgresql+asyncpg://incident_intel:local-dev-only-change-me@localhost:5433/incident_intel
# Integration tests; the database name must end in _test (created automatically by compose).
TEST_DATABASE_URL=postgresql+asyncpg://incident_intel:local-dev-only-change-me@localhost:5433/incident_intel_test

# --- API keys ---
# Server-side pepper for API-key hashes (min 32 chars). `make env` generates one.
# Changing it invalidates every existing API key.
API_KEY_PEPPER=
